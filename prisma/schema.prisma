// =======================================================
// JEFECORE DATABASE SCHEMA
// Version: 1.1.0 - Smart Contract Marketplace
// El Jefe Logistics
// =======================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =======================================================
// ENUMS
// =======================================================

enum UserRole {
  CEO
  MANAGER
  HR
  DISPATCHER
  FLEET_MANAGER
  FINANCE
  WORKSHOP
  DRIVER
  APPLICANT
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum NotificationType {
  SYSTEM
  FLEET
  DRIVER
  DISPATCH
  WORKSHOP
  FUEL
  CUSTOMER
  FINANCE
  DOCUMENT
}

enum DocumentCategory {
  GENERAL
  VEHICLE
  DRIVER
  CUSTOMER
  JOB
  INVOICE
  MAINTENANCE
  FUEL
  COMPLIANCE
}

enum DriverRank {
  TRAINEE
  JUNIOR
  SENIOR
  ELITE
}

enum DriverStatus {
  AVAILABLE
  DRIVING
  OFF_DUTY
  ON_LEAVE
  SUSPENDED
}

enum TruckStatus {
  AVAILABLE
  DELIVERING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum TruckManufacturer {
  VOLVO
  SCANIA
  DAF
  MAN
  MERCEDES
  RENAULT
  IVECO
}

enum TruckType {
  TRACTOR
  RIGID
}

enum MaintenanceStatus {
  REPORTED
  SCHEDULED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  ROUTINE
  HIGH
  CRITICAL
}

enum MaintenanceType {
  INSPECTION
  PREVENTIVE_SERVICE
  REPAIR
  TYRES
  MOT
  BREAKDOWN
  OTHER
}

enum FuelType {
  DIESEL
  HVO
  ADBLUE
  ELECTRIC
  OTHER
}

enum CustomerStatus {
  LEAD
  ACTIVE
  ON_HOLD
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  OVERDUE
  VOID
}

enum ContractListingStatus {
  DRAFT
  OPEN
  AWARDED
  CLOSED
  CANCELLED
}

enum ContractBidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Ets2TrailerType {
  DRY_FREIGHT
  INSULATED
  REFRIGERATED
  CURTAINSIDER
  FLATBED
  CONTAINER_CARRIER
  LOG_TRAILER
  FOOD_TANK
  FUEL_CISTERN
  CHEMICAL_TANK
  GAS_CISTERN
  SILO
  DUMPER
  MOVING_FLOOR
  LOW_BED
  LOW_LOADER
  LIVESTOCK
}

enum CargoCategory {
  GENERAL
  REFRIGERATED
  FROZEN
  LIQUID_FOOD
  FUEL
  CHEMICALS
  GASES
  DRY_BULK
  CONSTRUCTION
  CONTAINERS
  LOGS
  HEAVY_EQUIPMENT
  LIVESTOCK
}

// =======================================================
// ACCOUNT
// Authentication & Website Access
// =======================================================

model Account {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  // Private community identities. These are only exposed through the
  // authenticated account owner's profile.
  steamId       String? @unique
  truckyUserId  String? @unique
  truckyUsername String?
  discordId     String? @unique

  role UserRole @default(DRIVER)

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  lastLogin DateTime?

  driver           Driver?
  notifications    Notification[]
  documents        Document[]        @relation("DocumentUploader")
  auditEvents      AuditEvent[]      @relation("AuditActor")
  contractListings ContractListing[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([email])
  @@index([role])
}

// =======================================================
// DRIVER
// Company Driver Profile
// =======================================================

model Driver {
  id String @id @default(cuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  employeeNumber String @unique

  callsign String?

  rank   DriverRank   @default(TRAINEE)
  status DriverStatus @default(AVAILABLE)

  reputation Float @default(100)

  totalDistanceKm Int @default(0)
  totalDeliveries Int @default(0)
  totalConvoys    Int @default(0)

  favouriteTruck String?
  assignedTrailer Ets2TrailerType?
  contractBids    ContractBid[]

  // Current truck relationships.
  // This will later be replaced/expanded with DriverAssignment history.
  trucks Truck[]

  joinedAt DateTime @default(now())

  notes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([employeeNumber])
  @@index([status])
  @@index([rank])
}

// =======================================================
// COMPANY
// El Jefe Logistics Company Record
// =======================================================

model Company {
  id String @id @default(cuid())

  name String
  code String @unique

  country      String
  headquarters String

  depots   Depot[]
  settings CompanySettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

// =======================================================
// CUSTOMER
// Customer relationship and commercial account record
// =======================================================

model Customer {
  id String @id @default(cuid())

  customerNumber String         @unique
  companyName    String
  status         CustomerStatus @default(LEAD)

  contactFirstName String
  contactLastName  String
  email            String
  phone            String?
  billingEmail     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  country      String  @default("United Kingdom")

  creditLimit      Float?
  paymentTermsDays Int               @default(30)
  notes            String?
  invoices         Invoice[]
  contractListings ContractListing[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([customerNumber])
  @@index([companyName])
  @@index([status])
  @@index([email])
  @@index([archivedAt])
}

// =======================================================
// INVOICE
// Customer billing and payment tracking
// =======================================================

model Invoice {
  id String @id @default(cuid())

  invoiceNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status      InvoiceStatus @default(DRAFT)
  description String
  issueDate   DateTime
  dueDate     DateTime
  subtotal    Float
  vatRate     Float         @default(20)
  vatAmount   Float
  total       Float
  amountPaid  Float         @default(0)
  paidAt      DateTime?
  reference   String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

// =======================================================
// SMART CONTRACT MARKETPLACE
// Freight opportunities, bids and award lifecycle
// =======================================================

model ContractListing {
  id        String @id @default(cuid())
  reference String @unique

  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   Account  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  title         String
  description   String
  origin        String
  destination   String
    cargoType     String
    cargoCategory CargoCategory  @default(GENERAL)
    requiredTrailer Ets2TrailerType @default(DRY_FREIGHT)
  weightKg      Float?
  pickupDate    DateTime
  deliveryDate  DateTime
  budget        Float
  currency      String                @default("GBP")
  contractTerms String
  status        ContractListingStatus @default(DRAFT)

  bids         ContractBid[] @relation("ListingBids")
  awardedBidId String?       @unique
  awardedBid   ContractBid?  @relation("AwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  awardedAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([createdById])
  @@index([status, pickupDate])
  @@index([origin, destination])
}

model ContractBid {
  id        String          @id @default(cuid())
  listingId String
  listing   ContractListing @relation("ListingBids", fields: [listingId], references: [id], onDelete: Cascade)

  carrierName   String
  contactEmail  String
  driverId      String?
  driver        Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trailerType   Ets2TrailerType?
  amount        Float
  estimatedDays Int
  proposal      String
  status        ContractBidStatus @default(PENDING)
  awardedFor    ContractListing?  @relation("AwardedBid")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([contactEmail])
  @@index([driverId])
}

// =======================================================
// DEPOT
// Fleet Depot / Company Location
// =======================================================

model Depot {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  city    String
  country String

  trucks Truck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([name])
  @@index([city])
}

// =======================================================
// JEFECORE ENTERPRISE PLATFORM LAYER
// =======================================================

model Notification {
  id String @id @default(cuid())

  recipientId String?
  recipient   Account? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  title      String
  message    String
  type       NotificationType     @default(SYSTEM)
  severity   NotificationSeverity @default(INFO)
  entityType String?
  entityId   String?
  entityHref String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  expiresAt  DateTime?

  @@index([recipientId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model Document {
  id String @id @default(cuid())

  name         String
  description  String?
  category     DocumentCategory @default(GENERAL)
  entityType   String?
  entityId     String?
  storageKey   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  externalUrl  String?

  uploadedById String?
  uploadedBy   Account? @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([archivedAt])
}

model AuditEvent {
  id String @id @default(cuid())

  actorId    String?
  actor      Account? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model CompanySettings {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  legalName               String
  tradingName             String?
  registrationNo          String?
  vatNumber               String?
  address                 String?
  phone                   String?
  email                   String?
  website                 String?
  logoUrl                 String?
  primaryColour           String  @default("#2563eb")
  currency                String  @default("GBP")
  locale                  String  @default("en-GB")
  vatRate                 Float   @default(20)
  invoicePrefix           String  @default("INV")
  nextInvoiceNo           Int     @default(1)
  notificationPreferences Json?
  integrations            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================================================
// TRUCK
// Fleet Vehicle Record
// =======================================================

model Truck {
  id String @id @default(cuid())

  fleetNumber  String @unique
  registration String @unique

  manufacturer TruckManufacturer
  model        String
  type         TruckType         @default(TRACTOR)

  year   Int
  colour String?

  mileage   Int @default(0)
  fuelLevel Int @default(100)

  status TruckStatus @default(AVAILABLE)

  // =====================================================
  // DEPOT RELATIONSHIP
  // =====================================================

  depotId String?
  depot   Depot?  @relation(fields: [depotId], references: [id], onDelete: SetNull)

  // =====================================================
  // CURRENT DRIVER RELATIONSHIP
  // =====================================================

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // =====================================================
  // FINANCIAL INFORMATION
  // =====================================================

  purchaseDate  DateTime?
  purchasePrice Float?
  currentValue  Float?

  maintenanceJobs MaintenanceJob[]
  fuelEntries     FuelEntry[]

  // =====================================================
  // AUDIT FIELDS
  // =====================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fleetNumber])
  @@index([registration])
  @@index([status])
  @@index([manufacturer])
  @@index([depotId])
  @@index([driverId])
}

// =======================================================
// FUEL ENTRY
// Vehicle refuelling and energy-cost history
// =======================================================

model FuelEntry {
  id String @id @default(cuid())

  reference String @unique
  truckId   String
  truck     Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)

  fuelType       FuelType @default(DIESEL)
  quantity       Float
  unitPrice      Float
  totalCost      Float
  odometerKm     Int
  fuelLevelAfter Int?

  station       String
  location      String?
  receiptNumber String?
  purchasedAt   DateTime
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([truckId])
  @@index([fuelType])
  @@index([purchasedAt])
  @@index([station])
}

// =======================================================
// MAINTENANCE JOB
// Workshop work order and service history
// =======================================================

model MaintenanceJob {
  id String @id @default(cuid())

  jobNumber String @unique
  truckId   String
  truck     Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)

  title       String
  description String?
  type        MaintenanceType
  priority    MaintenancePriority @default(ROUTINE)
  status      MaintenanceStatus   @default(REPORTED)

  odometerKm Int?
  technician String?
  vendor     String?

  reportedAt   DateTime  @default(now())
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  estimatedCost Float?
  actualCost    Float?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([truckId])
  @@index([status])
  @@index([priority])
  @@index([scheduledFor])
}
